{% extends "lab_base.html.j2" %}
{% block scripts %}<script src="/lab/static/form.js" defer></script><script src="/lab/static/editor.js" defer></script>{% endblock %}
{% block style %}
<style>
  .editor { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 14px; align-items: start; margin-top: 12px; }
  @media (max-width: 1000px) { .editor { grid-template-columns: 1fr; } }
  .yaml-pane { position: sticky; top: 52px; }
  #yaml { width: 100%; height: calc(100vh - 150px); min-height: 360px; resize: vertical; tab-size: 2; white-space: pre; line-height: 1.45; }
  #yaml-state { font-size: 12px; min-height: 18px; }
  .form details.sec { border: 1px solid var(--line); background: var(--panel); margin: 0 0 10px; padding: 0 12px; }
  .form details.sec > summary { color: var(--green); font-weight: 700; margin: 8px 0; }
  .form details.sec[open] { padding-bottom: 12px; }
  .form details.sub { border-left: 2px solid var(--line-2); padding-left: 10px; margin: 8px 0; }
  .form details.sub > summary { color: var(--amber); margin: 4px 0; }
  .fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px 12px; }
  label.f { min-width: 0; }
  label.f .k { color: var(--fg); } label.f .k.set { color: var(--amber); }
  label.f small { color: var(--muted); font-size: 11px; line-height: 1.3; }
  label.f input, label.f select { width: 100%; }
  .wide { grid-column: 1 / -1; }
  .item { border: 1px dashed var(--line-2); padding: 8px; margin: 6px 0; }
  .item .head { display: flex; justify-content: space-between; align-items: center; color: var(--dim); margin-bottom: 6px; }
  .checks { display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--fg); font-size: 12px; }
  .checks label { display: inline-flex; gap: 5px; align-items: center; color: var(--fg); }
  .yamlonly { color: var(--muted); font-size: 12px; }
  .yamlonly code { white-space: pre-wrap; }
  .tabsel { display: flex; flex-wrap: wrap; gap: 4px; margin: 4px 0 10px; }
  .tabsel button { font: inherit; font-size: 12px; background: transparent; color: var(--dim); border: 1px solid var(--line-2); padding: 2px 10px; cursor: pointer; }
  .tabsel button.on { color: var(--bg); background: var(--green); border-color: var(--green); }
  .axis { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(160px, 1fr) auto; gap: 8px; align-items: end; margin: 6px 0; }
  .toolbar2 { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
  .toolbar2 .grp { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding-right: 14px; border-right: 1px solid var(--line-2); }
  .toolbar2 .grp:last-child { border-right: none; }
  .dirty { color: var(--amber); }
  #output pre { max-height: 460px; }
  .pick { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  @media (max-width: 1000px) { .pick { grid-template-columns: 1fr; } }
  .pick h3 { margin: 0 0 10px; }
  .pick-head { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; justify-content: space-between; min-height: 32px; margin-bottom: 10px; }
  .pick-head h3 { margin: 0; } .pick-head input { flex: 1; min-width: 180px; max-width: 320px; }
  .exp-cards { display: grid; gap: 8px; max-height: calc(100vh - 260px); overflow-y: auto; }
  .exp-card { display: block; width: 100%; text-align: left; font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--line-2); padding: 8px 12px; cursor: pointer; }
  .exp-card:hover, .exp-card:focus-visible { border-color: var(--green); outline: none; }
  .exp-card .top { display: flex; gap: 10px; align-items: baseline; justify-content: space-between; }
  .exp-card .top b { color: var(--green); overflow-wrap: anywhere; }
  .exp-card .desc { color: var(--muted); font-size: 12px; margin: 2px 0 4px; }
  .exp-card .meta { display: flex; flex-wrap: wrap; gap: 4px 6px; font-size: 11px; }
  .pill { border: 1px solid var(--line-2); color: var(--dim); padding: 0 6px; }
  .pill.ph { color: var(--cyan); border-color: var(--cyan); }
  .pill.res { color: var(--green); border-color: var(--green); }
  .pill.err { color: var(--red); border-color: var(--red); }
  .new-steps { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 12px; }
  .new-steps li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 8px; }
  .new-steps .n { display: inline-grid; place-items: center; width: 22px; height: 22px; border: 1px solid var(--green); color: var(--green); font-size: 12px; }
  .new-steps input, .new-steps select { display: block; margin-top: 4px; max-width: 100%; }
  .new-steps .checks { margin-top: 4px; }
  .filebar { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .filebar #title { font-size: 16px; color: var(--green); }
  .filebar .spacer { flex: 1; }
  .saveas input { margin-left: 4px; }
</style>
{% endblock %}
{% block content %}
<h1>test<span class="cursor"></span></h1>
{% with here = "test" %}{% include "_guide.html.j2" %}{% endwith %}
<p class="help">Open an experiment or create one. Files live in <code id="folder"></code>, next to the examples, so <code>llb run</code> works on them by hand too. While editing, the form and the YAML on the right stay in sync, and the form keeps the YAML's comments.</p>

<section id="picker" hidden>
  <div class="pick">
    <div class="panel">
      <div class="pick-head">
        <h3>open an experiment</h3>
        <input id="filter" type="search" placeholder="filter by name, model, tag…" aria-label="filter experiments">
      </div>
      <div id="exp-cards" class="exp-cards"></div>
    </div>
    <div class="panel" id="new-box">
      <div class="pick-head"><h3>new experiment</h3></div>
      <ol class="new-steps">
        <li><span class="n">1</span><div><b>name</b> <span class="hint">also the file and the results folder</span>
          <input id="new-name" placeholder="my-experiment" size="32" aria-label="experiment name">
          <div class="hint" id="new-where"></div></div></li>
        <li><span class="n">2</span><div><b>machine</b> <span class="hint">llama.cpp build, cooldown, telemetry</span>
          <select id="new-profile" aria-label="machine profile"></select></div></li>
        <li><span class="n">3</span><div><b>models</b> <span class="hint">downloaded in the models tab</span>
          <div class="checks" id="new-models"></div></div></li>
        <li><span class="n">4</span><div><b>what to measure</b>
          <div class="checks" id="new-presets"></div></div></li>
        <li><span class="n">5</span><div><b>extra suites</b> <span class="hint">optional: a synthetic one goes to latency, any other to quality</span>
          <div class="checks" id="new-suites"></div></div></li>
      </ol>
      <button class="btn" id="new-create">create and open</button>
    </div>
  </div>
</section>

<section id="workspace" hidden>
<div class="panel filebar">
  <button class="btn small" id="back" title="back to the list of experiments">← experiments</button>
  <b id="title"></b>
  <span id="dirty"></span>
  <span class="spacer"></span>
  <label class="dim saveas">file <input id="name" placeholder="my-experiment.yaml" size="26"></label>
  <button class="btn small" id="save">save</button>
</div>

<div class="panel" style="margin-top:10px">
  <div class="toolbar2">
    <div class="grp"><button class="btn small" id="validate">validate</button><button class="btn small" id="plan">plan</button></div>
    <div class="grp">
      <span class="dim">models</span><span class="checks" id="run-models"></span>
      <label class="dim"><input type="checkbox" id="resume"> --resume</label>
      <label class="dim"><input type="checkbox" id="no-build"> --no-build</label>
      <button class="btn" id="run">run</button>
    </div>
    <div class="grp"><button class="btn small" id="guide">guide</button></div>
    <div class="grp">
      <span class="checks"><label><input type="checkbox" name="fmt" value="html" checked>html</label><label><input type="checkbox" name="fmt" value="md" checked>md</label><label><input type="checkbox" name="fmt" value="png">png</label></span>
      <button class="btn small" id="report">report</button>
    </div>
    <div class="grp"><label class="dim"><input type="checkbox" id="force"> --force</label><button class="btn small" id="judge">judge</button></div>
  </div>
  <p class="hint" style="margin:8px 0 0">run, judge and report save the file first. <b>validate</b> and <b>plan</b> check the text as it is, saved or not.</p>
</div>
<div id="output"></div>

<div class="editor">
  <div class="form" id="form"></div>
  <div class="yaml-pane">
    <textarea id="yaml" spellcheck="false" aria-label="experiment YAML"></textarea>
    <div id="yaml-state"></div>
  </div>
</div>
</section>
{% endblock %}
