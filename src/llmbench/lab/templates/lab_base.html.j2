{% extends "base.html.j2" %}
{% block title %}llb lab · {{ tab }}{% endblock %}
{% block crumbs %}/lab/{{ tab }}{% endblock %}
{% block head %}
<script src="/lab/static/common.js" defer></script>
{% block scripts %}{% endblock %}
<style>
  .term-bar .tabs a { font-weight: 600; }
  .row { display: flex; flex-wrap: wrap; align-items: end; gap: 10px 14px; }
  .row label, label.f { display: flex; flex-direction: column; gap: 3px; color: var(--muted); font-size: 12px; }
  input, select, textarea { padding: 5px 8px; background: var(--bg); color: var(--fg); border: 1px solid var(--line-2); font: inherit; outline: none; }
  input:focus, select:focus, textarea:focus { border-color: var(--green); }
  input[type=number] { width: 100px; } input[type=checkbox] { accent-color: var(--green); }
  select { max-width: 100%; }
  button.btn.small, a.btn.small { padding: 2px 8px; font-size: 12px; }
  a.btn { display: inline-block; color: var(--green); border: 1px solid var(--green); padding: 6px 12px; }
  a.btn:hover { background: var(--green); color: var(--bg); text-decoration: none; }
  button.btn.red { color: var(--red); border-color: var(--red); } button.btn.red:hover:not(:disabled) { background: var(--red); color: var(--bg); }
  #msg { position: fixed; right: 16px; bottom: 16px; max-width: 560px; z-index: 30; }
  #msg div { background: var(--panel-2); border: 1px solid var(--line-2); border-left: 3px solid var(--red); padding: 8px 12px; margin-top: 6px; white-space: pre-wrap; }
  #msg div.ok { border-left-color: var(--green); }
  .bar { height: 6px; background: var(--line); margin: 4px 0; } .bar i { display: block; height: 100%; background: var(--green); }
  .cards { margin: 12px 0; } .card b { font-size: 16px; }
  #activity:empty { display: none; }
  #activity { margin: 8px 0 0; display: grid; gap: 8px; }
  #activity pre { max-height: 320px; margin: 6px 0 0; }
  .hint { color: var(--dim); font-size: 12px; }
  .state { margin: 8px 0; } .state pre { max-height: 220px; }
  details.guide { border: 1px solid var(--line); border-left: 3px solid var(--cyan); background: var(--panel); padding: 0 14px; margin: 0 0 12px; }
  details.guide > summary { color: var(--cyan); font-weight: 700; margin: 9px 0; }
  details.guide[open] { padding-bottom: 12px; }
  .steps { margin: 4px 0 10px; padding-left: 0; list-style: none; display: grid; gap: 8px; color: var(--dim); max-width: 1100px; }
  .steps li.on { color: var(--fg); } .steps li.on b { color: var(--green); }
  .examples { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 12px; }
  .examples pre { margin: 2px 0 0; max-height: none; }
  .cheats td { vertical-align: top; } .cheats td.use { color: var(--dim); white-space: normal; min-width: 260px; max-width: 520px; }
  .cheats pre { margin: 0; padding: 6px 8px; max-height: 260px; font-size: 12px; }
</style>
{% block style %}{% endblock %}
{% endblock %}
{% block body %}
<div class="cards" id="machine"></div>
<div id="activity"></div>
{% block content %}{% endblock %}
<div id="msg" aria-live="polite"></div>
{% endblock %}
{% block footer %}llb v{{ version }} · local-llm-bench-lab · lab: listens on 127.0.0.1, reach it through an SSH tunnel or <code>tailscale serve</code> · <a href="/api/docs">/api/docs</a>{% endblock %}
