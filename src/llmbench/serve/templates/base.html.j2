<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>{% block title %}llb {{ 'lab' if lab else 'dashboard' }}{% endblock %}</title>
<script src="/static/htmx.min.js"></script>
<script src="/static/llb.js" defer></script>
{% block head %}{% endblock %}
<style>
  :root {
    --bg: #0a0e0c; --panel: #0e1411; --panel-2: #121a16; --line: #1f2b24; --line-2: #2b3a30;
    --fg: #c9d4cc; --dim: #8a9a8f; --muted: #5f7166;
    --green: #4ade80; --amber: #fbbf24; --red: #f87171; --cyan: #22d3ee; --pink: #f472b6;
    --mono: ui-monospace, "JetBrains Mono", "Cascadia Code", "Fira Code", "SF Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 13px/1.55 var(--mono); }
  ::selection { background: var(--green); color: var(--bg); }
  a { color: var(--cyan); text-decoration: none; } a:hover { text-decoration: underline; }
  code { color: var(--amber); }

  .term-bar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 14px; padding: 8px 16px;
    background: var(--panel); border-bottom: 1px solid var(--line); }
  .dots { display: flex; gap: 6px; } .dots i { width: 11px; height: 11px; border-radius: 50%; display: block; }
  .dots i:nth-child(1) { background: #ff5f57; } .dots i:nth-child(2) { background: #febc2e; } .dots i:nth-child(3) { background: #28c840; }
  .prompt { color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .prompt .user { color: var(--green); } .prompt .path { color: var(--cyan); } .prompt a { color: inherit; }
  .term-bar .right { margin-left: auto; color: var(--muted); white-space: nowrap; }
  .term-bar .tabs { display: flex; gap: 12px; } .term-bar .tabs a { color: var(--dim); } .term-bar .tabs a.on { color: var(--green); }

  main { max-width: 1320px; margin: 0 auto; padding: 20px 16px 80px; }
  h1 { font-size: 22px; font-weight: 700; margin: 6px 0 4px; color: #e7efe9; }
  h1::before { content: "$ "; color: var(--green); }
  h1 .cursor { display: inline-block; width: .6em; height: 1.05em; margin-left: 4px; vertical-align: -2px; background: var(--green); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  h2 { font-size: 14px; font-weight: 700; margin: 40px 0 10px; color: var(--green); text-transform: lowercase; letter-spacing: .02em;
    display: flex; align-items: center; gap: 10px; scroll-margin-top: 90px; }
  h2::before { content: "##"; color: var(--muted); }
  h2::after { content: ""; flex: 1; border-top: 1px dashed var(--line-2); }
  h3 { font-size: 13px; color: var(--amber); margin: 22px 0 8px; } h3::before { content: "> "; color: var(--muted); }
  .muted { color: var(--muted); } .dim { color: var(--dim); }
  .meta { color: var(--dim); } .meta b { color: var(--fg); font-weight: 600; }
  .help { color: var(--dim); max-width: 980px; margin: 0 0 10px; padding-left: 12px; border-left: 2px solid var(--line-2); }
  .help b { color: var(--fg); }

  nav.sections { position: sticky; top: 41px; z-index: 9; display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 18px -16px 0; padding: 8px 16px;
    background: color-mix(in srgb, var(--bg) 92%, transparent); border-bottom: 1px solid var(--line); backdrop-filter: blur(4px); }
  nav.sections a { color: var(--dim); } nav.sections a::before { content: "#"; color: var(--muted); } nav.sections a:hover { color: var(--green); text-decoration: none; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 18px 0; }
  .card { background: var(--panel); border: 1px solid var(--line); padding: 10px 14px; }
  .card b { display: block; font-size: 20px; color: #e7efe9; font-weight: 700; }
  .card span { color: var(--muted); font-size: 12px; }
  .card.hl { border-color: var(--green); } .card.hl b { color: var(--green); }

  .panel { background: var(--panel); border: 1px solid var(--line); padding: 12px 14px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 12px; }
  dl.kv { display: grid; grid-template-columns: max-content 1fr; gap: 3px 16px; margin: 0; }
  dl.kv dt { color: var(--muted); } dl.kv dt::after { content: ":"; } dl.kv dd { margin: 0; color: var(--fg); word-break: break-word; }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 6px 0 8px; }
  input.filter, select.filter { flex: 0 1 380px; min-width: 0; padding: 6px 10px; background: var(--panel); color: var(--fg); border: 1px solid var(--line-2); font: inherit; outline: none; }
  input.filter::placeholder { color: var(--muted); }
  input.filter:focus, select.filter:focus { border-color: var(--green); box-shadow: 0 0 0 1px var(--green); }
  .count { color: var(--muted); font-size: 12px; }
  button.btn { font: inherit; padding: 6px 12px; background: transparent; color: var(--green); border: 1px solid var(--green); cursor: pointer; }
  button.btn:hover:not(:disabled) { background: var(--green); color: var(--bg); }
  button.btn:disabled { color: var(--muted); border-color: var(--line-2); cursor: default; }

  .wrap { overflow-x: auto; border: 1px solid var(--line); background: var(--panel); }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: 6px 10px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; vertical-align: top; }
  thead th { position: sticky; top: 0; background: var(--panel-2); color: var(--dim); font-weight: 600; font-size: 12px; text-transform: lowercase; user-select: none; }
  table.sortable thead th:not(.nosort) { cursor: pointer; }
  table.sortable thead th:not(.nosort):hover { color: var(--green); }
  table.sortable thead th:not(.nosort)::after { content: " ↕"; color: var(--line-2); }
  table.sortable thead th[data-sort="asc"]::after { content: " ▲"; color: var(--green); }
  table.sortable thead th[data-sort="desc"]::after { content: " ▼"; color: var(--green); }
  tbody tr:hover td { background: #111b15; }
  tbody tr:last-child td { border-bottom: none; }
  td.num, th.num { text-align: right; }
  .ok { color: var(--green); } .ko { color: var(--red); } .warn { color: var(--amber); }
  .tag { display: inline-block; padding: 0 6px; border: 1px solid var(--line-2); color: var(--dim); margin: 0 4px 2px 0; }
  .tag.v { color: var(--amber); border-color: #4a3b12; }
  .winner td { background: #0f2117; } .winner td:first-child { box-shadow: inset 3px 0 0 var(--green); }
  tr.baseline td { background: #0f1c22; } tr.baseline td:first-child { box-shadow: inset 3px 0 0 var(--cyan); }
  .delta { display: block; font-size: 11px; } .delta.up { color: var(--green); } .delta.down { color: var(--red); } .delta.same { color: var(--muted); }
  pre { background: var(--panel); border: 1px solid var(--line); padding: 12px; overflow-x: auto; max-height: 460px; margin: 8px 0; color: var(--fg); }
  pre.cmd::before { content: "$ "; color: var(--green); }
  details > summary { cursor: pointer; color: var(--dim); margin: 10px 0; } details > summary:hover { color: var(--green); }
  .chart { border: 1px solid var(--line); background: var(--panel); margin: 8px 0 4px; padding: 6px; }
  .live::before { content: "●"; color: var(--green); margin-right: 2px; animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: .25; } }
  .wrapcell { white-space: normal; min-width: 260px; max-width: 560px; }
  footer { color: var(--muted); border-top: 1px solid var(--line); margin-top: 60px; padding-top: 10px; font-size: 12px; }
  @media (max-width: 640px) { .grid2 { grid-template-columns: 1fr; } .term-bar .right { display: none; } }
</style>
</head>
<body>
<div class="term-bar">
  <div class="dots"><i></i><i></i><i></i></div>
  <div class="prompt"><span class="user">llb@{{ 'lab' if lab else 'dashboard' }}</span>:<span class="path"><a href="/">~</a>{% block crumbs %}{% endblock %}</span>$</div>
  {% if lab %}<nav class="tabs">{% for t in ["models", "chat", "test", "suites", "system", "info"] %}<a href="/lab/{{ t }}"{% if tab == t %} class="on"{% endif %}>{{ t }}</a>{% endfor %}<a href="/"{% if not tab %} class="on"{% endif %}>results</a></nav>{% endif %}
  <div class="right">llb v{{ version }} · {{ 'lab' if lab else 'read-only' }}</div>
</div>
<main>{% block body %}{% endblock %}
<footer>{% block footer %}llb v{{ version }} · local-llm-bench-lab · data read from SQLite, never written · <a href="/api/docs">/api/docs</a>{% endblock %}</footer>
</main>
</body>
</html>
