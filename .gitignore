# Allowlist: everything at the top level is ignored unless it is listed here.
# To put a new top-level file or directory under version control, add a `!` line.
# Local tooling (.venv, caches, .claude, editor folders, .llb_home, .hf_home, dotfiles…)
# stays out without having to be named.
/*
!/.github/
!/.gitignore
!/.pre-commit-config.yaml
!/.python-version
!/CHANGELOG.md
!/README.md
!/LICENSE
!/experiments/
!/models/
!/pyproject.toml
!/src/
!/suites/
!/tests/
!/uv.lock

# --- Inside the allowed directories ------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Models: keep only the README (favorites live here, never in git)
/models/*
!/models/README.md
*.gguf

# Benchmark data, wherever it ends up
*.sqlite
*.sqlite-*
*.parquet

# Secrets
.env
.env.*
