#!/usr/bin/env python3
"""Stand-in for `lm_eval`: checks the server it was pointed at, writes a results JSON."""

import json
import sys
import time
import urllib.request
from pathlib import Path


def opt(name: str) -> str:
    return sys.argv[sys.argv.index(name) + 1]


model_args = dict(kv.split("=", 1) for kv in opt("--model_args").split(","))
base = model_args["base_url"].split("/v1/")[0]
with urllib.request.urlopen(f"{base}/health") as r:  # the server must be up
    assert r.status == 200
out = Path(opt("--output_path")) / model_args["model"]
out.mkdir(parents=True, exist_ok=True)
results = {
    task: {"alias": task, "exact_match,strict-match": 0.25, "exact_match_stderr,strict-match": 0.1,
           "exact_match,flexible-extract": 0.5}
    for task in opt("--tasks").split(",")
}
(out / f"results_{time.time():.0f}.json").write_text(json.dumps({"results": results}))
print("|Tasks|Version|...")
