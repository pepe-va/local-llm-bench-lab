#!/usr/bin/env python3
"""Stand-in for llama-bench (commit c811cb8) used by integration tests.

- `--help` / `--version` print the captured real outputs ($FAKE_BENCH_FIXTURE_DIR).
- Otherwise emits one JSONL row per test, shaped like the real tool.
- Fails like the real tool when `-ctk q4_0` is requested (unsupported head size),
  or with exit 137-style SIGKILL when FAKE_BENCH_OOM=1.
"""

import json
import os
import signal
import sys
from pathlib import Path

def fixture(name: str) -> str:
    return (Path(os.environ["FAKE_BENCH_FIXTURE_DIR"]) / name).read_text()


def opt(args: list[str], *names: str, default: str | None = None) -> str | None:
    for i, a in enumerate(args):
        if a in names and i + 1 < len(args):
            return args[i + 1]
    return default


def main() -> int:
    args = sys.argv[1:]
    if "--help" in args:
        sys.stdout.write(fixture("llama-bench.help.txt"))
        return 0
    if "--version" in args:
        sys.stderr.write(fixture("llama-bench.version.txt"))
        return 0
    if os.environ.get("FAKE_BENCH_OOM") == "1":
        os.kill(os.getpid(), signal.SIGKILL)
    ctk = opt(args, "-ctk", default="f16")
    if ctk == "q4_0":
        sys.stderr.write("llama_init_from_model: K cache type q4_0 with block size 32 "
                         "does not divide n_embd_head_k=8\n")
        sys.stderr.write("llama_bench: error: failed to create context with model\n")
        return 1

    reps = int(opt(args, "-r", default="5") or 5)
    threads = int(opt(args, "-t", default="4") or 4)
    prompts = [int(x) for x in (opt(args, "-p", default="512") or "").split(",") if x]
    gens = [int(x) for x in (opt(args, "-n", default="128") or "").split(",") if x]
    depths = [int(x) for x in (opt(args, "-d", default="0") or "").split(",") if x]
    base = json.loads(fixture("llama-bench.jsonl").splitlines()[0])
    tests = [(p, 0) for p in prompts if p] + [(0, n) for n in gens if n]
    for depth in depths:
        for p, n in tests:
            speed = (100.0 if p else 10.0) * threads
            samples = [speed * (1 + 0.01 * i) for i in range(reps)]
            row = base | {
                "model_filename": opt(args, "-m"),
                "n_threads": threads,
                "type_k": ctk,
                "n_prompt": p,
                "n_gen": n,
                "n_depth": depth,
                "avg_ts": sum(samples) / reps,
                "stddev_ts": 1.0,
                "avg_ns": 1000,
                "stddev_ns": 10,
                "samples_ts": samples,
                "samples_ns": [1000] * reps,
            }
            print(json.dumps(row))
    return 0


if __name__ == "__main__":
    sys.exit(main())
